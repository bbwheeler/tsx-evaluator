# Copy to .env and fill in, or export these as real environment variables.

# --- gRPC server ---
GRPC_PORT=50052

# --- PostgreSQL connection ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tsx_evaluator
DB_SSLMODE=disable

# --- tsx-tracker service ---
TRACKER_ADDR=localhost:50051

# --- Evaluation behaviour ---
# How often the background evaluator picks a stock to analyse.
EVAL_INTERVAL=8h
# How many stocks to evaluate per cycle.
EVAL_BATCH_SIZE=1

# --- Financial Modeling Prep (FMP) ---
# Free tier: 250 API calls/day. Get a key at https://financialmodelingprep.com
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

# --- LLM (Ollama) ---
# Base URL for the Ollama API (must be reachable from this service)
LLM_BASE_URL=http://192.168.1.71:11434
# Model to use for sentiment analysis (must be pulled in Ollama first)
LLM_MODEL=ornith:35b
# Timeout for LLM requests
LLM_TIMEOUT=30m
