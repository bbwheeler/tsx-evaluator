# Environment variables for Podman deployment.
# Edit before running install.sh or the service.

# --- gRPC server ---
GRPC_PORT=50052

# --- PostgreSQL (external instance) ---
DB_HOST=192.168.1.31
DB_PORT=5432
DB_USER=__FILL_IN__
DB_PASSWORD=__FILL_IN__
DB_NAME=tsx_evaluator
DB_SSLMODE=disable

# --- tsx-tracker service ---
TRACKER_ADDR=192.168.1.31:50051

# --- Evaluation behaviour ---
EVAL_INTERVAL=8h
EVAL_BATCH_SIZE=1

# --- Financial Modeling Prep (FMP) ---
FMP_API_KEY=__FILL_IN__
FMP_BASE_URL=https://financialmodelingprep.com

# --- LLM (Ollama) ---
LLM_BASE_URL=http://192.168.1.71:11434
LLM_MODEL=ornith:35b
LLM_TIMEOUT=30m
